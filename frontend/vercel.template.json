{
  "$schema":"https://openapi.vercel.sh/vercel.json",
  "framework":"vite",
  "buildCommand":"npm run build",
  "outputDirectory":"dist",
  "rewrites":[
    {"source":"/api/:path*","destination":"https://YOUR_BACKEND_HOST.invalid/api/:path*"},
    {"source":"/(.*)","destination":"/index.html"}
  ]
}
