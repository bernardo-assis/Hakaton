    {
      "name": "Isolamento — configurar ID de outra carteira",
      "item": [
        {
          "name": "Cofre alheio retorna 404",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-AgentSafe-CSRF",
                "value": "1"
              }
            ],
            "url": "{{base_url}}/api/vaults/{{other_vault_id}}",
            "description": "Crie o ID com uma segunda carteira em outro cookie jar/workspace; mantenha sessão da primeira aqui. O teste não deve modificar o cofre alheio.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FROZEN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Foreign vault hidden\",()=>pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Agente alheio retorna 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/agents/{{other_agent_id}}/history",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Foreign agent hidden\",()=>pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Legacy user bypass desabilitado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-AgentSafe-CSRF",
                "value": "1"
              }
            ],
            "url": "{{base_url}}/api/users",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Legacy disabled\",()=>pm.response.to.have.status(501));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Segurança — rejeições",
      "item": [
        {
          "name": "Assinatura incorreta",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-AgentSafe-CSRF",
                "value": "1"
              }
            ],
            "url": "{{base_url}}/api/auth/verify",
            "description": "Para testar criptografia incorreta em desafio válido, emita desafio novo antes; desafio consumido testa replay.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_id\": \"{{challenge_id}}\",\n  \"signature\": \"AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA==\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid proof rejected\",()=>pm.expect(pm.response.code).to.be.oneOf([400,401,409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Desafio expirado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-AgentSafe-CSRF",
                "value": "1"
              }
            ],
            "url": "{{base_url}}/api/auth/verify",
            "description": "Use desafio emitido há mais de cinco minutos e sua assinatura correspondente. Não executar imediatamente após challenge: seria outro teste.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"challenge_id\": \"{{challenge_id}}\",\n  \"signature\": \"{{signature_base64}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Expired proof rejected\",()=>pm.expect(pm.response.code).to.be.oneOf([400,401,409]));"
                ]
              }
            }
          ]
        },
        {
          "name": "Origin indevida",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "http://evil.invalid"
              },
              {
                "key": "X-AgentSafe-CSRF",
                "value": "1"
              }
            ],
            "url": "{{base_url}}/api/auth/challenge",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_pubkey\": \"{{owner_pubkey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Bad origin rejected\",()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        },
        {
          "name": "Header CSRF ausente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              }
            ],
            "url": "{{base_url}}/api/auth/challenge",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"owner_pubkey\": \"{{owner_pubkey}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Missing CSRF rejected\",()=>pm.response.to.have.status(403));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Logout — executar no final",
      "item": [
        {
          "name": "Revogar sessão",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "X-AgentSafe-CSRF",
                "value": "1"
              }
            ],
            "url": "{{base_url}}/api/auth/logout",
            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const result=pm.response.json();",
                  "pm.test(\"Successful envelope\",()=>pm.expect(result.success).to.eql(true));",
                  "pm.test(\"Logged out\",()=>pm.expect(result.data.authenticated).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Sessão após logout",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/auth/session",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\",()=>pm.response.to.have.status(200));",
                  "const result=pm.response.json();",
                  "pm.test(\"Successful envelope\",()=>pm.expect(result.success).to.eql(true));",
                  "pm.test(\"Anonymous\",()=>pm.expect(result.data.authenticated).to.eql(false));"
                ]
              }
            }
          ]
        },
        {
          "name": "Dashboard anônimo retorna 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{base_url}}/api/dashboard",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unauthorized\",()=>pm.response.to.have.status(401));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
