DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SSL=false
PORT=3001
NODE_ENV=development
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUST_PROXY_HOPS=0
SOLANA_RPC_URL=https://api.devnet.solana.com
DEVNET_PAYMENTS_ENABLED=false
# Set a stable base64 32-byte key outside Git before enabling payments.
VAULT_SIGNER_ENCRYPTION_KEY=
# Docker may supply DATABASE_URL_FILE and VAULT_SIGNER_ENCRYPTION_KEY_FILE instead.
